# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=change-me

APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me
PREVIEW_SECRET=change-me
# Nuxt session cookie secret, at least 32 chars: openssl rand -base64 48
SESSION_SECRET=change-me
